# UI login (defaults: admin / admin — change CPW_AUTH_SECRET in production)
CPW_AUTH_ENABLED=true
CPW_AUTH_USERNAME=admin
CPW_AUTH_PASSWORD=admin
CPW_AUTH_SECRET=change-me-in-production

# Knox / Hadoop JWT for optional HTTPS metric scrapes (never commit real values)
KNOX_JWT=
HADOOP_JWT=

# Paths (defaults work for local dev)
CPW_CONFIG_DIR=./config
CPW_KUBECONFIG_DIR=./kubeconfigs
CPW_SECRETS_DIR=./secrets
CPW_FILE_SD_DIR=./deploy/data/prometheus/file_sd
CPW_PROMETHEUS_URL=http://127.0.0.1:9090
# When Prometheus runs in Docker but exporters run on the host (Mac): host.docker.internal
CPW_SCRAPE_HOST=host.docker.internal
CPW_GRAFANA_URL=http://127.0.0.1:3000
CPW_OTEL_LOGS_ENDPOINT=http://127.0.0.1:4318/v1/logs
CPW_OPENSEARCH_URL=http://127.0.0.1:9200
# Local without Docker: SQLite (default). With Docker hub: postgresql+asyncpg://cpw:cpw@127.0.0.1:5432/cpw
DATABASE_URL=sqlite+aiosqlite:///deploy/data/cpw.db

# SMTP (Mailpit local: host 127.0.0.1 port 1025 — UI http://127.0.0.1:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=alerts@cpw.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_START_TLS=false
SMTP_USE_TLS=false
ALERT_DEFAULT_RECIPIENTS=ops@example.com
COLLECTOR_INTERVAL_SEC=60
ALERT_EVAL_INTERVAL_SEC=15

# LLM recommendations (Headroom proxy — compresses context before inference)
CPW_LLM_BASE_URL=http://127.0.0.1:8787/v1
CPW_LLM_MODEL=openai/gpt-4o-mini
CPW_LLM_API_KEY=
CPW_OVERVIEW_CACHE_SEC=1.25
